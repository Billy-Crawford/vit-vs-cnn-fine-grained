# ============================================================
# ViT vs CNN — Variables d'Environnement Docker
# ============================================================

# Mode d'inférence backend :
# - false : charge les vrais modèles PyTorch depuis results/runs/
# - true  : utilise des mocks aléatoires (pratique pour tests légers)
USE_MOCK=false

# URL de l'API backend accessible par le navigateur client
NEXT_PUBLIC_API_URL=http://localhost:8000

# Ports exposés sur la machine hôte
BACKEND_PORT=8000
FRONTEND_PORT=3000
MLFLOW_PORT=5000
